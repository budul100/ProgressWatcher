root = true

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

# C# styling preferences
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Naming conventions: PascalCase for types and methods
dotnet_naming_rule.methods_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.methods_should_be_pascal_case.symbols = all_methods
dotnet_naming_rule.methods_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.all_methods.applicable_kinds = method
dotnet_naming_symbols.all_methods.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Encourage descriptive test method names in PascalCase
dotnet_naming_rule.test_methods_pascal_case.severity = suggestion
dotnet_naming_rule.test_methods_pascal_case.symbols = test_methods
dotnet_naming_rule.test_methods_pascal_case.style = pascal_case_style

dotnet_naming_symbols.test_methods.applicable_kinds = method
dotnet_naming_symbols.test_methods.applicable_accessibilities = public